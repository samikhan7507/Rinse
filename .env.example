# Settings for Rinse.
#   Local:  run.bat / run.sh copy this file to .Renviron the first time you start Rinse.
#   Render: Environment tab -> "Add from .env", then paste or upload these lines.
# Put comments on their own line; an inline comment would become part of the value.
# The administrator account is created on the FIRST start with an empty database. Changing
# the email or password here later does not change an account that already exists
# (change the password in Settings, or delete the database file to start again).

RINSE_ADMIN_EMAIL=samikhan57705@gmail.com
RINSE_ADMIN_PASSWORD=sami@123
RINSE_ADMIN_NAME=Md Sami Ahmad

# Where the SQLite database lives, the largest upload in MB, log level and idle sign-out minutes
RINSE_DB=storage/rinse.sqlite
RINSE_MAX_UPLOAD_MB=25
RINSE_LOG_LEVEL=INFO
RINSE_IDLE_MINUTES=30

# Optional: Google sign-in (the redirect URI must match Google Cloud Console exactly).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-site.onrender.com

# Optional: phone sign-in by SMS (Twilio). Without these the Phone tab is hidden.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

# Classroom demo only: show the Phone tab with the code on screen (not secure, never use on a public site).
# RINSE_DEMO_SMS=1

# Only for docker compose with Caddy: the public domain name
# RINSE_DOMAIN=localhost
